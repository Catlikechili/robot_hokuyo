# REALSENSE T265 TRÊN UBUNTU (KHI CAMERA HIỆN MOVIDIUS MA2X5X)

## 1. Kiểm tra camera

lsusb

Nếu thấy:

03e7:2150 Movidius MA2X5X

=> T265 đang ở bootloader.

Nếu thấy:

8087:0b37 Intel RealSense T265

=> Camera đã hoạt động.


## 2. Tải librealsense 2.50.0

cd ~

git clone https://github.com/IntelRealSense/librealsense.git

cd librealsense

git checkout v2.50.0


## 3. Cài dependency

sudo apt update

sudo apt install -y \
git cmake build-essential \
libssl-dev \
libusb-1.0-0-dev \
libgtk-3-dev \
pkg-config \
libglfw3-dev \
libgl1-mesa-dev \
libglu1-mesa-dev \
python3-dev \
python3-pip \
python3-setuptools \
python3-wheel


## 4. Cài udev rule

sudo ./scripts/setup_udev_rules.sh

sudo udevadm control --reload-rules

sudo udevadm trigger


## 5. Build librealsense với TM2 và Python

mkdir build

cd build

cmake .. \
-DCMAKE_BUILD_TYPE=Release \
-DBUILD_WITH_TM
